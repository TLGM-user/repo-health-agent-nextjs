<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Keep all NuGet payloads on F: -->
  <config>
    <add key="globalPackagesFolder" value="F:\build-cache\nuget\packages" />
    <add key="repositoryPath" value="F:\build-cache\nuget\packages" />
    <add key="http_cache" value="F:\build-cache\nuget\v3-cache" />
    <add key="plugins_cache" value="F:\build-cache\nuget\plugins-cache" />
  </config>
  <fallbackPackageFolders>
    <add key="F-cache" value="F:\build-cache\nuget\fallback" />
  </fallbackPackageFolders>
</configuration>
